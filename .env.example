# Copy to .env. Enter your own PostgreSQL credentials; never commit .env.
PGHOST=127.0.0.1
PGPORT=5432
PGDATABASE=document_checker
PGUSER=document_checker
PGPASSWORD=
# Alternatively set DATABASE_URL=postgresql+psycopg://user:encoded_password@localhost:5432/document_checker
# Separate PG* fields support passwords containing @, :, / without URL escaping.
UPLOAD_DIR=storage/uploads
MAX_UPLOAD_MB=20
MAX_PAGES=200
MAX_CHUNKS=2000
MAX_REFERENCE_CHUNKS=10000
CHUNK_CHARS=700
# Semantic mode is optional. Install requirements.txt before enabling it.
ENABLE_SEMANTIC=false
SEMANTIC_MODEL=keepitreal/vietnamese-sbert
# Ngưỡng khởi đầu từ evaluation/results/REPORT.md; đo lại khi có dữ liệu thật.
LEXICAL_THRESHOLD=0.08
SEMANTIC_THRESHOLD=0.68
# OCR chỉ chạy cho trang PDF không đủ text layer.
ENABLE_OCR=true
TESSERACT_CMD=tesseract
OCR_LANGUAGE=vie+eng
OCR_DPI=200
MAX_OCR_PAGES=30
OCR_PAGE_TIMEOUT=30
OCR_MIN_TEXT_CHARS=1
# Giới hạn trình bày sau khi đã gộp và khử cảnh báo trùng.
MAX_ALERTS_PER_SOURCE=1000
MAX_ALERTS_PER_REPORT=1000
# Serper Google Search API. Keep the key only in .env; never commit it or expose it to frontend.
SERPER_API_KEY=
SERPER_TIMEOUT_SECONDS=20
SERPER_MAX_RESULTS=10
SERPER_MAX_QUERIES=5
SERPER_SIMILARITY_THRESHOLD=0.08
